    "已選取 %lld 張照片": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選取 %lld 張照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 枚の写真を選択"
          }
        }
      }
    },
    "確定要刪除%lld張照片嗎？": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除%lld張照片嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚の写真を削除しますか？"
          }
        }
      }
    },
    "確定要刪除此照片嗎？": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除此照片嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を削除しますか？"
          }
        }
      }
    },
    "刪除 %lld 張拍立得": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 %lld 張拍立得"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 枚のチェキを削除"
          }
        }
      }
    },
    "刪除拍立得": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除拍立得"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェキを削除"
          }
        }
      }
    },
    "刪除此拍立得": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除此拍立得"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェキを削除"
          }
        }
      }
    },
    "此操作會將拍立得從 ChekiLens 典藏庫與 iOS 系統相簿中一併刪除。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作會將拍立得從 ChekiLens 典藏庫與 iOS 系統相簿中一併刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェキは ChekiLens と iOS の「写真」アプリの両方から削除されます。"
          }
        }
      }
    },
    "此操作會將拍立得從 ChekiLens 典藏庫移除，且無法復原。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作會將拍立得從 ChekiLens 典藏庫移除，且無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェキは ChekiLens から削除され、元に戻すことはできません。"
          }
        }
      }
    },
    "此拍立得（含正反面與特典會備忘）將從典藏庫與 iOS 系統相簿中一併刪除。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此拍立得（含正反面與特典會備忘）將從典藏庫與 iOS 系統相簿中一併刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェキ（両面およびメモを含む）は ChekiLens と iOS の「写真」アプリの両方から削除されます。"
          }
        }
      }
    },
    "此拍立得（含背面與特典會備忘）將從典藏庫永久移除。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此拍立得（含背面與特典會備忘）將從典藏庫永久移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェキ（裏面およびメモを含む）はライブラリから完全に削除されます。"
          }
        }
      }
    },
    "尚無拍立得典藏": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無拍立得典藏"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェキがまだありません"
          }
        }
      }
    },
    "從系統相簿匯入您的拍立得照片，或載入範例測試資料體驗完整相冊與正反面典藏功能。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從系統相簿匯入您的拍立得照片，或載入範例測試資料體驗完整相冊與正反面典藏功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」アプリからチェキを取り込むか、サンプルデータを読み込んで両面コレクション機能をお試しください。"
          }
        }
      }
    },
    "從相簿選擇照片（不限張數）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從相簿選擇照片（不限張數）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムから写真を選択（枚数無制限）"
          }
        }
      }
    },
    "開啟批次配對工作台（含測試資料）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟批次配對工作台（含測試資料）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括ペアリングを開く（テストデータ付）"
          }
        }
      }
    },
    "批次配對工作台（含測試資料）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次配對工作台（含測試資料）"
