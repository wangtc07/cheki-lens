    "新增成員": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增成員"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーを追加"
          }
        }
      }
    },
    "尚無團體相冊": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無團體相冊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループアルバムがありません"
          }
        }
      }
    },
    "建立團體與推角成員，即可按「團體 ＞ 成員」階層管理拍立得相冊。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立團體與推角成員，即可按「團體 ＞ 成員」階層管理拍立得相冊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループと推しメンバーを作成すると、「グループ ＞ メンバー」階層でチェキを整理できます。"
          }
        }
      }
    },
    "尚無成員相冊": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無成員相冊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーアルバムがありません"
          }
        }
      }
    },
    "新增您的推角成員，直接展開瀏覽所有成員的專屬相冊。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增您的推角成員，直接展開瀏覽所有成員的專屬相冊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推しメンバーを追加すると、メンバー別の専用アルバムを一覧できます。"
          }
        }
      }
    },
    "此團體尚無成員": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此團體尚無成員"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループにはメンバーがいません"
          }
        }
      }
    },
    "點擊右上角「+」為 %@ 新增成員相冊。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊右上角「+」為 %@ 新增成員相冊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「+」をタップして %@ にメンバーアルバムを追加しましょう。"
          }
        }
      }
    },
    "尚無拍立得項目": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無拍立得項目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェキ項目がありません"
          }
        }
      }
    },
    "點擊右上角「＋」或「⋯」匯入或拍攝拍立得至此相冊。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊右上角「＋」或「⋯」匯入或拍攝拍立得至此相冊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「＋」または「⋯」から、このアルバムにチェキを取り込むか撮影できます。"
          }
        }
      }
    },
    "使用相機拍攝至此相冊": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相機拍攝至此相冊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラで撮影してこのアルバムに追加"
          }
        }
      }
    },
    "從相簿多選匯入（不限張數）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從相簿多選匯入（不限張數）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムから複数選択して取り込む（無制限）"
          }
        }
      }
    },
    "在配對工作台中匯入至此相冊": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
