      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入範例測試資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータを読み込む"
          }
        }
      }
    },
    "新增團體 / 成員": {
      "extractionState": "manual",
      "localizations": {
